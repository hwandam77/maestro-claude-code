# Maestro Claude Code - 환경 변수 템플릿
# cp .env.example .env 후 실제 값 입력

# === ZAI API (GLM-5, Coding Plan $3/월) ===
# maestro.sh / claude-glm 에서 사용
ZAI_API_KEY=your-zai-api-key

# === 클라우드 모델 API 키 (에스컬레이션용) ===
# Codex - gpt-4o 등 코드 생성 에스컬레이션
OPENAI_API_KEY=your-openai-api-key

# Gemini - gemini-2.0-flash 등 멀티모달/디자인 에스컬레이션
GOOGLE_API_KEY=your-google-api-key

# Claude 구독 - 최종 에스컬레이션 (thinking/보안 감사)
ANTHROPIC_API_KEY=your-anthropic-api-key

# === LiteLLM Proxy 설정 ===
# ccproxy-start.sh / maestro.sh 에서 사용
CCPROXY_PORT=4000
LITELLM_MASTER_KEY=maestro-local-key

# === 자체 서버 (Tailscale VPN 필요) ===
# nexus - Qwen3.5-122B (llama-server, 400K context)
# Tailscale IP: 100.124.117.46, API IP: 100.64.189.120
NEXUS_HOST=100.64.189.120
NEXUS_PORT=8080
QWEN35_TIMEOUT=120

# cognit - Qwen3-Coder-30B-A3B (vLLM, 20K context)
# Tailscale IP: 100.121.138.74
COGNIT_HOST=100.121.138.74
COGNIT_PORT=8000
QWEN_CODER_TIMEOUT=120

# === 외부 서비스 ===
TAVILY_API_KEY=tvly-xxxxx
